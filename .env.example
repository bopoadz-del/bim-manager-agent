# Copy to .env for local development. Never commit a filled-in copy.

MEPJ_DATABASE_URL=postgresql+psycopg://mepj:mepj@localhost:5432/mepj
MEPJ_REDIS_URL=redis://localhost:6379

# Creates the first project and issues the first real key. Rotate it.
MEPJ_BOOTSTRAP_API_KEY=change-me

MEPJ_ARTIFACTS_DIR=./artifacts/mep-judge
MEPJ_UPLOAD_DIR=./var/uploads
MEPJ_BUILD_SHA=dev

# Zoning
MEPJ_MAX_ELEMENTS_PER_ZONE=800
MEPJ_GRID_FALLBACK_M=6.0
MEPJ_ZONE_BUFFER_M=2.0

# Resolver
MEPJ_MAX_ATTEMPTS_PER_CLASH=3
MEPJ_WORKER_CONCURRENCY=4

# Speckle. Absent, the service uses the local model store and says so at /health.
MEPJ_SPECKLE_HOST=http://localhost:3000
# MEPJ_SPECKLE_TOKEN=

# Only rule extraction and BCF prose use a model. Never clash or merge decisions.
# ANTHROPIC_API_KEY=
